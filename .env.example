# ===========================================
# Sistema de Gestión Académica - MODDLE
# Variables de Entorno
# ===========================================

# ----- Base de Datos PostgreSQL -----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=moddle

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379

# ----- JWT -----
JWT_SECRET=change-this-to-a-super-secret-key-min-32-chars
JWT_EXPIRATION=1h

# ----- Moodle Integration -----
MOODLE_URL=https://your-moodle-instance.edu
MOODLE_TOKEN=your-moodle-webservice-token

# ----- Application -----
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# ----- Logging -----
LOG_LEVEL=debug
