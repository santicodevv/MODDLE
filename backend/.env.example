NODE_ENV=production
PORT=3000

# Opción 1: DATABASE_URL (recomendado para Railway/Neon/Supabase)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Opción 2: Variables individuales (para desarrollo local)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=moddle_user
# DB_PASSWORD=moddle_pass
# DB_NAME=moddle_db

JWT_SECRET=cambia-esto-por-un-secreto-seguro-largo-random
JWT_EXPIRATION=8h

CORS_ORIGINS=https://tu-app.vercel.app

# Microsoft Azure AD (OAuth2 - SSO)
# Para restringir solo a tu universidad, cambia 'common' por el Tenant ID de Office 365 de la universidad
MICROSOFT_TENANT_ID=tu-tenant-id-o-common
# (Opcional) Dominio de correo permitido de la universidad, ej: uasd.edu.do
ALLOWED_EMAIL_DOMAIN=tu-universidad.edu.do
MICROSOFT_CLIENT_ID=tu-client-id
MICROSOFT_CLIENT_SECRET=tu-client-secret
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback

MOODLE_URL=https://tu-moodle.edu/moodle
MOODLE_TOKEN=tu_token_de_servicio_moodle

# Payments (KNOROOMS / GoHighLevel)
PAYMENTS_API_URL=https://services.leadconnectorhq.com
PAYMENTS_API_TOKEN=tu_private_integration_token
PAYMENTS_LOCATION_ID=tu_location_id