NODE_ENV=production
PORT=3000

# Opción 1: DATABASE_URL (recomendado para Railway/Neon/Supabase)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Opción 2: Variables individuales (para desarrollo local)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=moddle_user
# DB_PASSWORD=moddle_pass
# DB_NAME=moddle_db

JWT_SECRET=cambia-esto-por-un-secreto-seguro-largo-random
JWT_EXPIRATION=8h

CORS_ORIGINS=https://tu-app.vercel.app

MOODLE_URL=https://tu-moodle.edu/moodle
MOODLE_TOKEN=tu_token_de_servicio_moodle